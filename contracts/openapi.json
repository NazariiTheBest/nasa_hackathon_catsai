  "info": {
    "description": "Crop-rotation decision support that fuses NASA Earth observations with soil data, crop traits and farmer priorities. It supports, and does not replace, farmer judgment.",
    "title": "Field Shift API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/analyze": {
      "post": {
        "description": "Diagnose the site and compare the baseline rotation with alternative strategies.",
        "operationId": "analyze_rotation_api_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Climate data could not be obtained"
          }
        },
        "summary": "Analyze Rotation",
        "tags": [
          "analysis"
        ]
      }
    },
    "/api/crops": {
      "get": {
        "operationId": "crops_api_crops_get",
        "parameters": [
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "default": "en",
              "enum": [
                "en",
                "uk"
              ],
              "title": "Lang",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CropCatalog"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Crops",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/locate": {
      "get": {
        "description": "Which data tier and unit a point falls in, without running an analysis.",
        "operationId": "locate_point_api_locate_get",
        "parameters": [
          {
            "description": "Latitude in WGS84",
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "description": "Latitude in WGS84",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "description": "Longitude in WGS84",
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "description": "Longitude in WGS84",
              "maximum": 180,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Locate Point",
        "tags": [
          "site"
        ]
      }
    },
    "/api/showcase": {
      "get": {
        "description": "Showcase fields as a GeoJSON FeatureCollection in WGS84.",
        "operationId": "showcase_api_showcase_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowcaseResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Showcase",
        "tags": [
          "site"
        ]
      }
    }
  }
}
